---
const { title = "Roy's Crew BBQ | Woodland Park, Colorado", description = "Roy's Crew BBQ serves mesquite-smoked barbecue, scratch-made sides, and family-owned warmth in Woodland Park, Colorado." } = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#171513" />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content="/Logo/Roys%20Logo.avif" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Roboto+Slab:wght@500;600;700;800&display=swap" rel="stylesheet" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root { --ink: #171513; --cream: #f4ebdd; --cream-deep: #e9ddca; --ember: #b6532a; --wood: #3a2920; --brass: #b9975b; --muted: #847a6e; --line: rgba(244, 235, 221, 0.18); --display: "Roboto Slab", Georgia, serif; --sans: "DM Sans", Arial, sans-serif; font-family: var(--sans); color: var(--cream); background: var(--ink); font-synthesis: none; text-rendering: optimizeLegibility; }
	* { box-sizing: border-box; }
	html { max-width: 100%; overflow-x: clip; scroll-behavior: smooth; }
	body { margin: 0; min-width: 0; max-width: 100%; overflow-x: clip; background: var(--ink); }
	a { color: inherit; text-decoration: none; }
	button, a { -webkit-tap-highlight-color: transparent; }
	button { font: inherit; }
	img { display: block; max-width: 100%; }
	::selection { color: var(--ink); background: var(--brass); }
	.eyebrow { color: var(--brass); font-size: 0.69rem; font-weight: 700; letter-spacing: 0.2em; line-height: 1.4; text-transform: uppercase; }
	.section-heading { margin: 0; font-family: var(--display); font-size: clamp(2.35rem, 5vw, 4.5rem); font-weight: 600; letter-spacing: -0.045em; line-height: 0.98; }
	.section-heading em { color: var(--ember); font-style: normal; }
	.button { align-items: center; display: inline-flex; gap: 0.9rem; justify-content: center; min-height: 3.25rem; padding: 0.85rem 1.35rem; border: 1px solid transparent; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.17em; text-transform: uppercase; transition: background 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease; }
	.button::after { content: "↗"; font-size: 1rem; letter-spacing: 0; }
	.button:hover { transform: translateY(-2px); }
	.button--ember { color: var(--cream); background: var(--ember); }
	.button--ember:hover { background: #d26639; }
	.button--outline { color: var(--cream); border-color: rgba(244, 235, 221, 0.58); }
	.button--outline:hover { color: var(--ink); background: var(--cream); }
	.button--dark { color: var(--cream); background: var(--ink); }
	.button--dark:hover { background: var(--ember); }
	.skip-link { background: var(--cream); color: var(--ink); left: 1rem; padding: 0.75rem 1rem; position: absolute; top: -5rem; z-index: 20; }
	.skip-link:focus { top: 1rem; }
	[data-reveal] { opacity: 0; transform: translateY(1.5rem); transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1), transform 700ms cubic-bezier(0.22, 1, 0.36, 1); transition-delay: var(--reveal-delay, 0ms); }
	[data-reveal="left"] { transform: translateX(-1.5rem); }
	[data-reveal="right"] { transform: translateX(1.5rem); }
	[data-reveal].is-visible { opacity: 1; transform: translate3d(0, 0, 0); }
	.hero-image img { animation: hero-drift 18s ease-in-out infinite alternate; transform-origin: center center; }
	@keyframes hero-drift { from { transform: scale(1.02); } to { transform: scale(1.07); } }
	@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; } }
</style>

<script>
	history.scrollRestoration = 'manual';
	const resetPagePosition = () => {
		if (window.location.hash) history.replaceState(null, '', `${window.location.pathname}${window.location.search}`);
		window.scrollTo(0, 0);
	};
	resetPagePosition();
	window.addEventListener('load', resetPagePosition, { once: true });
	window.addEventListener('pageshow', resetPagePosition);

	const revealTargets = document.querySelectorAll('main > section, .food-card, .menu-category, .story-photo, .story-copy, .visit-details, .footer-top');
	let lastScrollY = window.scrollY;
	let scrollingDown = true;
	revealTargets.forEach((element, index) => {
		const target = element as HTMLElement;
		target.setAttribute('data-reveal', target.matches('.story-photo, .story-copy') ? (index % 2 ? 'right' : 'left') : 'up');
		target.style.setProperty('--reveal-delay', `${Math.min(index % 5, 4) * 70}ms`);
	});

	window.addEventListener('scroll', () => {
		const currentScrollY = window.scrollY;
		scrollingDown = currentScrollY >= lastScrollY;
		lastScrollY = currentScrollY;
		if (!scrollingDown) revealTargets.forEach((element) => {
			if (element.getBoundingClientRect().top > window.innerHeight) element.classList.remove('is-visible');
		});
	}, { passive: true });

	const revealObserver = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting && !entry.target.classList.contains('is-visible')) entry.target.classList.add('is-visible');
		});
	}, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

	revealTargets.forEach((element) => revealObserver.observe(element));
</script>
