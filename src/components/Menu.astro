---
const mains = [
	["67 Sandwich", "$16", "Includes your choice of one meat and one side."],
	["Tractor Man Sandwich", "$28", "Brisket, ham, hot links, pulled pork, two onion rings, and a side."],
	["Chicken Fried Steak Sandwich", "$19", "Real hand-battered with one side."],
	["Chicken Fried Steak", "$22", "Real hand-battered steak with two sides and white gravy."],
	["Fried Southern Catfish", "$20", "Fried fillets with two sides and hushpuppies."],
	["Pork Belly Burnt Ends", "$15", "Half pound, barbecued in sauce."],
	["Popcorn Shrimp with Hushpuppies", "$16", "Includes one side of your choice."],
	["Chicken Tenders", "$17", "Four fried tenders with two sides and one dipping sauce: BBQ, honey mustard, gravy, mango habanero, or ranch."],
	["Chef Salad", "$15", "Choice of one meat with eggs, tomatoes, cheese, cucumber, red onion, green onions, croutons, and one dressing: ranch, vinaigrette, bleu cheese, honey mustard, or 1000 Island. Add avocado for $2."],
	["24 Tater", "$15", "Butter, sour cream, cheese, green onions, bacon bits, and choice of one meat. Add green chile queso for $2."],
	["Motherlode Mac N Cheese", "$15", "Mac n cheese topped with brisket or pulled pork, green chile, bacon bits, and shredded cheese."],
];

const specialties = [
	["Okie Fries", "$15", "Crispy fries with cheese, bacon, green chile queso, jalapeños, and green onions. Choice of one meat."],
	["Nacho Mountain", "$15", "Homemade tortilla chips with cheese, bacon, green chile queso, jalapeños, green onions, and sour cream. Choice of one meat. Add avocado for $2."],
	["BBQ Burrito or Bowl", "$15", "Customize with rice, green chile, salsa, cheese, green onions, diced tomatoes, and one meat of your choice. Add avocado or green chile queso for $2 each."],
];

const smokedMeats = ["Ribs", "Brisket", "Sausage", "Hot links", "Ham", "Turkey", "Pulled pork", "Chicken breast"];
const sides = ["Potato salad", "Cole slaw", "Pinto beans", "Onion rings", "French fries", "Fried okra", "Mashed potatoes", "Cream corn", "Mac N Cheese", "Spanish rice", "Fried pickles", "Fried green beans", "Sweet potato tots"];
---

<section class="menu-section" id="menu-details">
	<div class="menu-heading"><div><p class="eyebrow">The full spread</p><h2 class="section-heading">Made for<br /><em>big appetites.</em></h2></div><p>Explore our menu of mesquite-smoked barbecue, comfort food, sides, and sweets. Call or order online to confirm today's availability.</p></div>
	<div class="meal-highlights" role="group" aria-label="Popular meal options">
		<article class="meal-highlight"><p class="meal-highlight-label">The classics</p><h3>BBQ Plates</h3><p>Served with a roll or cornbread.</p></article>
		<article class="meal-highlight"><p class="meal-highlight-label">One meat</p><h3>Summit Single</h3><p>1 meat · 2 sides</p><strong>$20</strong></article>
		<article class="meal-highlight"><p class="meal-highlight-label">Two meats</p><h3>Cascade Combo</h3><p>2 meats · 2 sides</p><strong>$24</strong></article>
		<article class="meal-highlight"><p class="meal-highlight-label">Three meats</p><h3>Teller Trio</h3><p>3 meats · 2 sides</p><strong>$28</strong></article>
		<article class="meal-highlight"><p class="meal-highlight-label">No age limit</p><h3>Kids Meal</h3><p>1 meat · 2 sides in kid-sized portions · small drink · roll or cornbread</p><strong>$10</strong></article>
	</div>
	<div class="menu-categories">
		<details class="menu-category"><summary><h3>Sandwiches, plates &amp; favorites</h3><b>+</b></summary><div class="menu-category-content">{mains.map((item) => <article class="menu-item"><div><h4>{item[0]}</h4><p>{item[2]}</p></div><strong>{item[1]}</strong></article>)}{specialties.map((item) => <article class="menu-item"><div><h4>{item[0]}</h4><p>{item[2]}</p></div><strong>{item[1]}</strong></article>)}</div></details>
		<details class="menu-category"><summary><h3>Mesquite-smoked meats</h3><b>+</b></summary><div class="menu-category-content"><ul class="meat-list">{smokedMeats.map((meat) => <li>{meat}</li>)}</ul><div class="menu-subitem pricing"><span>By the pound</span><small><b>Brisket</b><br />¼ lb $8 · ½ lb $15 · 1 lb $29<br /><b>Pork spare ribs</b><br />½ rack $17 · full rack $30<br /><b>Hot links, smoked sausage, pulled pork, ham, chicken, turkey</b><br />¼ lb $6 · ½ lb $11 · 1 lb $22</small></div><div class="menu-subitem"><span>BBQ sauce</span><small>Pint $6 · Quart $9</small></div></div></details>
		<details class="menu-category"><summary><h3>Sides &amp; sweets</h3><b>+</b></summary><div class="menu-category-content"><ul class="side-list">{sides.map((side) => <li>{side}</li>)}</ul><div class="menu-subitem"><span>Sides</span><b>$3.50</b><small>Pint $7 · Quart $14<br />Side salad or baked potato: substitute for a side +$3, or add on for $6</small></div><div class="menu-subitem"><span>Desserts</span><small>Fruit cobbler $6 (ask cashier for flavor)<br />Homemade vanilla ice cream $4<br />Special ice cream $5 (ask cashier)<br />Fresh huge cinnamon roll $8</small></div></div></details>
	</div>
	<div class="menu-footer">
		<a class="menu-footer-catering" href="#catering">Ask about catering <span aria-hidden="true">↗</span></a>
		<p class="menu-footer-allergens">Milk, eggs, crustaceans, shellfish, tree nuts, wheat, peanuts, soy, and sesame may be used in our kitchen.</p>
	</div>
</section>

<style>
	.menu-section { background: var(--wood); color: var(--cream); padding: 8rem 5vw; }
	.menu-heading { align-items: end; display: grid; gap: 4rem; grid-template-columns: 1fr 0.7fr; margin: 0 auto 4.5rem; max-width: 100rem; }
	.menu-heading .section-heading { margin-top: 1.2rem; }
	.menu-heading > p { color: rgba(244, 235, 221, 0.68); font-size: 0.92rem; line-height: 1.75; margin: 0; max-width: 27rem; }
	.meal-highlights { display: grid; gap: 1px; grid-template-columns: repeat(5, minmax(0, 1fr)); margin: 0 auto 4rem; max-width: 100rem; background: var(--line); border: 1px solid var(--line); }
	.meal-highlight { background: var(--wood); min-width: 0; padding: 1.4rem 1.25rem; position: relative; }
	.meal-highlight-label { color: var(--brass); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.13em; margin: 0 0 0.55rem; text-transform: uppercase; }
	.meal-highlight h3 { font-family: var(--display); font-size: 1.05rem; line-height: 1.2; margin: 0 0 0.5rem; }
	.meal-highlight > p:not(.meal-highlight-label) { color: rgba(244, 235, 221, 0.62); font-size: 0.72rem; line-height: 1.5; margin: 0; }
	.meal-highlight strong { color: var(--brass); display: block; font-family: var(--display); font-size: 1rem; margin-top: 0.8rem; }
	.menu-categories { border-top: 1px solid var(--line); margin: 0 auto; max-width: 100rem; }
	.menu-category { border-bottom: 1px solid var(--line); }
	.menu-category summary { align-items: center; cursor: pointer; display: flex; gap: 1rem; justify-content: space-between; list-style: none; padding: 1.5rem 0; }
	.menu-category summary::-webkit-details-marker { display: none; }
	.menu-category summary h3 { font-family: var(--display); font-size: 1.7rem; margin: 0; }
	.menu-category summary b { color: var(--brass); flex: 0 0 2rem; font-size: 1.5rem; font-weight: 400; margin-left: auto; text-align: right; transition: transform 180ms ease; }
	.menu-category[open] summary b { transform: rotate(45deg); }
	.menu-category-content { display: grid; gap: 0 2.5rem; grid-template-columns: repeat(3, 1fr); padding: 0 2rem 2.5rem; }
	.menu-category-content .menu-note { grid-column: 1 / -1; }
	.menu-category-content .menu-item { min-width: 0; }
	.menu-category-content .menu-subitem { align-self: start; }
	.menu-note, .menu-item p, .menu-subitem small { color: rgba(244, 235, 221, 0.58); font-size: 0.75rem; line-height: 1.5; }
	.menu-note { margin: -0.5rem 0 1.5rem; }
	.menu-item { align-items: start; border-bottom: 1px solid var(--line); display: flex; gap: 1rem; justify-content: space-between; padding: 1rem 0; }
	.menu-item h4 { font-family: var(--display); font-size: 0.98rem; font-weight: 600; margin: 0; }
	.menu-item p { margin: 0.25rem 0 0; }
	.menu-item strong { color: var(--brass); flex: 0 0 auto; font-family: var(--display); font-size: 0.9rem; font-weight: 600; }
	.menu-subitem { border-bottom: 1px solid var(--line); display: grid; gap: 0.25rem 0.7rem; grid-template-columns: 1fr auto; padding: 1.25rem 0; }
	.menu-subitem span { color: var(--brass); font-family: var(--display); font-size: 1rem; }
	.menu-subitem b { font-family: var(--display); font-weight: 600; }
	.menu-subitem small { grid-column: 1 / -1; }
	.meat-list, .side-list { columns: 2; list-style: none; margin: 0 0 1rem; padding: 0; }
	.meat-list li, .side-list li { color: rgba(244, 235, 221, 0.8); font-family: var(--display); font-size: 0.92rem; padding: 0.3rem 0; }
	.meat-list li::before, .side-list li::before { color: var(--ember); content: "·"; margin-right: 0.45rem; }
	.menu-footer { align-items: start; border-top: 1px solid var(--line); color: rgba(244, 235, 221, 0.6); display: flex; font-size: 0.67rem; gap: 2rem; justify-content: space-between; letter-spacing: 0.08em; margin: 4rem auto 0; max-width: 100rem; padding-top: 1.3rem; text-transform: uppercase; }
	.menu-footer-catering { color: var(--brass); flex: 0 0 auto; }
	.menu-footer-catering span { font-size: 0.8rem; margin-left: 0.3rem; }
	.menu-footer-allergens { line-height: 1.5; margin: 0; max-width: 38rem; text-align: right; }
	@media (max-width: 900px) { .menu-section { padding: 6rem 4vw; } .menu-heading { gap: 2rem; grid-template-columns: 1fr 1fr; } .meal-highlights { grid-template-columns: repeat(3, minmax(0, 1fr)); } .meal-highlight:last-child { grid-column: span 2; } .menu-category-content { grid-template-columns: repeat(2, 1fr); padding-inline: 1rem; } }
	@media (max-width: 720px) { .menu-section { padding: 4.5rem 1.25rem; } .menu-heading { display: block; margin-bottom: 2.5rem; } .menu-heading > p { margin-top: 1.5rem; } .meal-highlights { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-bottom: 2.5rem; } .meal-highlight { padding: 1.1rem 1rem; } .meal-highlight:last-child { grid-column: 1 / -1; } .menu-category summary { min-height: 4.25rem; } .menu-category summary h3 { font-size: clamp(1.15rem, 5.8vw, 1.4rem); line-height: 1.15; max-width: 15rem; } .menu-category-content { display: block; padding: 0 0 1.5rem; } .menu-item { gap: 0.75rem; } .menu-item h4 { font-size: 0.9rem; line-height: 1.25; } .menu-item p, .menu-subitem small, .menu-note { font-size: 0.72rem; } .menu-item strong { font-size: 0.82rem; } .menu-footer { flex-direction: column; gap: 0.8rem; margin-top: 2.5rem; padding-top: 1.2rem; } .menu-footer-allergens { text-align: left; } }
</style>
